# ─────────────────────────────────────────────────────────────
# Telegram (obrigatório)
# ─────────────────────────────────────────────────────────────
# Token do bot. Fale com @BotFather no Telegram, mande /newbot,
# escolha um nome e ele te devolve o token. Leva 1 minuto, é grátis.
TELEGRAM_BOT_TOKEN=1234567890:AAExemploDeTokenDoBotFather

# Opcional: deixe VAZIO. O bot descobre sozinho o seu chat na primeira vez
# que você mandar /start pra ele. Só preencha se quiser fixar manualmente.
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo

# Hora do aviso "tem jogo hoje" (0-23, horário de Brasília)
DIGEST_HOUR=8

# De quantos em quantos segundos checar os lances DURANTE o jogo.
# 90s é o padrão: a API da ESPN não tem rate limit, então checar mais
# rápido não custa nada e o aviso de gol chega bem antes.
POLL_INTERVAL_SECONDS=90

# Começa a acompanhar o jogo X minutos antes do apito inicial
PREMATCH_LEAD_MINUTES=15

# Acompanhamento ligado por padrão. Rodando em rajadas no GitHub Actions,
# depender de um comando pra ligar só atrapalharia.
AUTO_TRACK=1

# Teto de duração do acompanhamento, em minutos. O limite de um job do
# GitHub Actions é 360; 210 cobre jogo + prorrogação + pênaltis.
MAX_WATCH_MINUTES=210

# ─────────────────────────────────────────────────────────────
# Clipe de gol ao vivo (opcional — o aviso de gol funciona sem isso)
# ─────────────────────────────────────────────────────────────
# Registre um app em https://www.reddit.com/prefs/apps (tipo "script",
# 2 minutos, sem cartão). Deixe vazio pra desligar essa busca.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBS=soccer,futebol
CLIP_SEARCH_WINDOW_MINUTES=10
